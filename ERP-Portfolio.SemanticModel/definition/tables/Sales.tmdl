/// Sales order lines (~60k, Jan 2024 - Oct 2026). Grain: one row per order line. Ship Date is blank and Order Status = Open for orders not yet shipped as of 2026-10-31. Promise is shipping within 5 days.
table Sales
	lineageTag: e3fa135a-b46d-481c-89c3-b73766511f74

	column 'Sales Line Key'
		dataType: int64
		isHidden
		lineageTag: 827a72ef-9d76-43c8-9696-ece37122a4fc
		summarizeBy: none
		sourceColumn: Sales Line Key

	column 'Order Number'
		dataType: string
		lineageTag: 1e0cf947-730c-4235-a83f-5a6b9135ad46
		summarizeBy: none
		sourceColumn: Order Number

	column 'Line Number'
		dataType: int64
		isHidden
		lineageTag: 83cb87bd-fc2a-46f3-9023-57caa9d230ec
		summarizeBy: none
		sourceColumn: Line Number

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 76c784e6-9aa5-4741-a512-a8092037f9b1
		summarizeBy: none
		sourceColumn: Order Date

	column 'Ship Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 451f2a5f-37b7-4453-9f43-a1a39d2d5077
		summarizeBy: none
		sourceColumn: Ship Date

	column CustomerKey
		dataType: int64
		isHidden
		lineageTag: da95032a-fe0d-4122-bc2e-c36887d8c13c
		summarizeBy: none
		sourceColumn: CustomerKey

	column ProductKey
		dataType: int64
		isHidden
		lineageTag: 971561fd-1073-4aac-b1a7-69ac10e9331a
		summarizeBy: none
		sourceColumn: ProductKey

	column EmployeeKey
		dataType: int64
		isHidden
		lineageTag: 95d21aa4-b8a3-4db8-962b-fd3484c5b48f
		summarizeBy: none
		sourceColumn: EmployeeKey

	column WarehouseKey
		dataType: int64
		isHidden
		lineageTag: f2299255-f1b8-41ff-bbb0-cbd57339f1f2
		summarizeBy: none
		sourceColumn: WarehouseKey

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 4433a3a2-86f9-43cb-879c-59df78e32c67
		summarizeBy: sum
		sourceColumn: Quantity

	column 'Unit Price'
		dataType: decimal
		isHidden
		formatString: \$#,0.00
		lineageTag: e898982c-4d27-4bf5-bca4-c7da761b44bb
		summarizeBy: none
		sourceColumn: Unit Price

	column 'Discount %'
		dataType: double
