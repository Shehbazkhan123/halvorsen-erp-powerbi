	column 'Ship Days'
		dataType: int64
		isHidden
		lineageTag: f0878b19-bd42-46a1-9b31-df32eabbd62d
		summarizeBy: none
		sourceColumn: Ship Days

	column 'Is On Time'
		dataType: boolean
		lineageTag: 0f2f644a-568d-4d7b-94a4-e417ca064ba9
		summarizeBy: none
		sourceColumn: Is On Time

	partition Sales = m
		mode: import
		source =
				let
				    NOrders = 20000,
				    StartDate = #date(2024, 1, 1),
				    Span = 1035,
				    AsOf = #date(2026, 10, 31),
				    Seasonality = {0.9, 0.85, 1.0, 1.0, 1.0, 1.05, 0.95, 0.95, 1.05, 1.1, 1.25, 1.3},
				    Lines = List.Combine(List.Transform({1..NOrders}, (o) =>
				        let
				            orderDate = Date.AddDays(StartDate, Number.RoundDown(Number.Power(fnRand(o, 61), 0.8) * Span)),
				            customer = 1 + Number.RoundDown(Number.Power(fnRand(o, 62), 1.6) * 500),
				            rep = 1 + Number.RoundDown(fnRand(o, 63) * 20),
				            wh = 1 + Number.RoundDown(fnRand(o, 64) * 5),
				            nLines = 1 + Number.RoundDown(fnRand(o, 65) * 5),
				            shipDays = 1 + Number.RoundDown(Number.Power(fnRand(o, 66), 4) * 10),
				            shipDate = Date.AddDays(orderDate, shipDays),
				            isShipped = shipDate <= AsOf,
				            season = Seasonality{Date.Month(orderDate) - 1}
				        in
				            List.Transform({1..nLines}, (l) =>
				                let
				                    i = o * 10 + l,
				                    p = 1 + Number.RoundDown(Number.Power(fnRand(i, 67), 1.3) * 120),
				                    qty = List.Max({1, Number.Round((1 + Number.RoundDown(fnRand(i, 68) * 20)) * season)}),
				                    r = fnRand(i, 69),
				                    disc = if r < 0.6 then 0 else if r < 0.85 then 0.05 else if r < 0.95 then 0.1 else 0.15,
				                    price = fnProductPrice(p),
				                    gross = Number.Round(qty * price, 2)
				                in [
				                    #"Sales Line Key" = i,
				                    #"Order Number" = "SO-" & Text.PadStart(Text.From(o), 6, "0"),
				                    #"Line Number" = l,
				                    #"Order Date" = orderDate,
				                    #"Ship Date" = if isShipped then shipDate else null,
				                    CustomerKey = customer,
				                    ProductKey = p,
				                    EmployeeKey = rep,
				                    WarehouseKey = wh,
				                    Quantity = qty,
				                    #"Unit Price" = price,
				                    #"Discount %" = disc,
				                    #"Gross Amount" = gross,
				                    #"Net Amount" = Number.Round(gross * (1 - disc), 2),
				                    #"Cost Amount" = Number.Round(qty * fnProductCost(p), 2),
				                    #"Order Status" = if isShipped then "Shipped" else "Open",
				                    #"Ship Days" = if isShipped then shipDays else null,
				                    #"Is On Time" = if isShipped then shipDays <= 5 else null
				                ]))),
				    Source = Table.FromRecords(Lines),
				    Typed = Table.TransformColumnTypes(Source, {{"Sales Line Key", Int64.Type}, {"Order Number", type text}, {"Line Number", Int64.Type}, {"Order Date", type date}, {"Ship Date", type date}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"EmployeeKey", Int64.Type}, {"WarehouseKey", Int64.Type}, {"Quantity", Int64.Type}, {"Unit Price", Currency.Type}, {"Discount %", type number}, {"Gross Amount", Currency.Type}, {"Net Amount", Currency.Type}, {"Cost Amount", Currency.Type}, {"Order Status", type text}, {"Ship Days", Int64.Type}, {"Is On Time", type logical}})
				in
				    Typed

